# Copia este fichero a .env.local y rellena los valores.
# .env.local esta en .gitignore: nunca lo subas al repositorio.

# --- Servicio de inventario ---
# URL base del servicio, con sufijo /v1. No es una credencial de tienda.
INVENTORY_API_URL=http://localhost:3001/v1

# Secreto de administracion del servicio de inventario. Solo se usa al registrar
# una tienda nueva (app/register/actions.ts): crea la organizacion, su API key y
# su ubicacion. La clave y la ubicacion resultantes se guardan por tienda en la
# tabla `organizations` de SQLite, no en este fichero.
INVENTORY_ADMIN_SECRET=

# --- Autenticacion ---
# Secreto de NextAuth v5. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# --- Tienda ---
STORE_NAME=Mi Tienda
# Decimal, no porcentaje: 0.10 = 10%
TAX_RATE=0.10

# --- Siembra del superadministrador (npm run seed) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
